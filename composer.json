{
  "name": "jalendport/craft-preparse",
  "description": "A field type that renders a Twig template when an element is saved and stores the typed result.",
  "type": "craft-plugin",
  "license": "mit",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "fieldtype",
    "preparse",
    "twig"
  ],
  "authors": [
    {
      "name": "Jalen Davenport",
      "homepage": "https://jalendport.com"
    },
    {
      "name": "André Elvan",
      "homepage": "https://www.vaersaagod.no"
    }
  ],
  "support": {
    "email": "hello@jalendport.com",
    "issues": "https://github.com/jalendport/craft-preparse/issues",
    "source": "https://github.com/jalendport/craft-preparse",
    "docs": "https://github.com/jalendport/craft-preparse/blob/master/README.md"
  },
  "require": {
    "php": "^8.2",
    "craftcms/cms": "^5.7",
    "jalendport/craft-base": "^1.1",
    "nystudio107/craft-code-editor": "^1.0.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "craftcms/rector": "dev-main",
    "pestphp/pest": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "jalendport\\preparse\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "jalendport\\preparse\\tests\\": "tests/"
    }
  },
  "extra": {
    "name": "Preparse",
    "handle": "preparse-field",
    "class": "jalendport\\preparse\\Preparse",
    "documentationUrl": "https://github.com/jalendport/craft-preparse/blob/master/README.md",
    "changelogUrl": "https://raw.githubusercontent.com/jalendport/craft-preparse/master/CHANGELOG.md"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
